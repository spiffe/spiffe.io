---
import presentationsYaml from "../data/presentations.yaml?raw";
import { parseYaml } from "../lib/content";

type Category = "introduction" | "case-study" | "deep-dive";
type Presentation = {
  title: string;
  link: string;
  youtube?: string;
  thumbnail?: string;
  presenters: string;
  organizations?: string;
  event?: string;
  date: string;
  type: "talk" | "podcast" | "article";
  category: Category;
  featured?: boolean;
  description?: string;
};
type Props = { category?: Category; featured?: boolean; filters?: boolean };

const { category, featured, filters } = Astro.props as Props;
const categories: Record<Category, [string, string]> = {
  introduction: ["Introduction", "Introductions"],
  "case-study": ["Case study", "Case studies"],
  "deep-dive": ["Deep dive", "Deep dives"],
};
const months = "Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec".split(" ");
const formatDate = (date: string) => {
  const [year, month] = date.split("-").map(Number);
  return `${months[month - 1]} ${year}`;
};

const all: Presentation[] = parseYaml(presentationsYaml);
const items = all
  .filter((p) => (!category || p.category === category) && (!featured || p.featured))
  .sort((a, b) => b.date.localeCompare(a.date));
const groups = filters
  ? Object.entries(Object.groupBy(items, (p) => p.date.slice(0, 4))).sort(
      ([a], [b]) => b.localeCompare(a),
    )
  : [["", items] as const];
const counts = Object.fromEntries(
  Object.keys(categories).map((c) => [c, items.filter((p) => p.category === c).length]),
);
---

{
  filters && (
    <div class="presentation-filters not-content" role="group" aria-label="Filter by category" hidden>
      <button type="button" data-filter="" aria-pressed="true">
        All <span>{items.length}</span>
      </button>
      {Object.entries(categories).map(([key, [, label]]) => (
        <button type="button" data-filter={key} aria-pressed="false">
          {label} <span>{counts[key]}</span>
        </button>
      ))}
    </div>
  )
}
<div class={filters ? "presentation-library" : undefined}>
{
  groups.map(([year, group]) => (
    <section class="presentation-group not-content">
      {year && <h3 class="presentation-year">{year}</h3>}
      <ul class="presentation-list">
        {group!.map((p) => (
          <li class="presentation" data-category={p.category}>
            <a class="presentation-thumb" href={p.link} tabindex="-1" aria-hidden="true">
              {p.youtube ? (
                <img src={`https://i.ytimg.com/vi/${p.youtube}/mqdefault.jpg`} alt="" loading="lazy" />
              ) : p.thumbnail ? (
                <img class="is-logo" src={p.thumbnail} alt="" loading="lazy" />
              ) : (
                <span class="presentation-type-icon">{p.type === "article" ? "Article" : "Podcast"}</span>
              )}
            </a>
            <div class="presentation-body">
              <a class="presentation-title" href={p.link}>
                {p.title}
              </a>
              <p class="presentation-meta">
                {[p.event, formatDate(p.date), p.type !== "talk" && p.type[0].toUpperCase() + p.type.slice(1)]
                  .filter(Boolean)
                  .join(" · ")}
                {filters && <span class="presentation-category">{categories[p.category][0]}</span>}
              </p>
              <p class="presentation-people">
                {p.presenters}
                {p.organizations && <span> · {p.organizations}</span>}
              </p>
              {p.description && <p class="presentation-description">{p.description}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))
}
</div>

{
  filters && (
    <script>
      const bar = document.querySelector<HTMLElement>(".presentation-filters")!;
      const buttons = [...bar.querySelectorAll("button")];
      bar.hidden = false;
      for (const button of buttons)
        button.addEventListener("click", () => {
          const filter = button.dataset.filter;
          for (const b of buttons) b.setAttribute("aria-pressed", String(b === button));
          for (const group of document.querySelectorAll<HTMLElement>(".presentation-library .presentation-group")) {
            let visible = 0;
            for (const row of group.querySelectorAll<HTMLElement>(".presentation")) {
              row.hidden = !!filter && row.dataset.category !== filter;
              if (!row.hidden) visible++;
            }
            group.hidden = visible === 0;
          }
        });
    </script>
  )
}
