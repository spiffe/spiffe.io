---
import { inline } from "../lib/content";
import {
  entries,
  entryId,
  entryLogo,
  formatLabels,
  provenanceLabels,
  sorted,
} from "../lib/ecosystem";

interface Props {
  kind: string;
}

const list = await Promise.all(
  sorted(entries.filter((e) => e.kind === Astro.props.kind)).map(
    async (e) => ({
      ...e,
      html: await inline(e.description),
      logo: entryLogo(e),
    }),
  ),
);
---

<div class="eco-entries not-content">
  {
    list.map((e) => (
      <article class="eco-entry" id={entryId(e)}>
        {e.logo.src ? (
          <img class="eco-logo" src={e.logo.src} alt="" loading="lazy" />
        ) : (
          <span class="eco-logo eco-monogram" aria-hidden="true">
            {e.logo.initials}
          </span>
        )}
        <header>
          <h3>{e.name}</h3>
          {e.kind !== "issuers" && e.accepts && (
            <p class="eco-labels">
              <span>Accepts</span>
              {e.accepts.map((f) => (
                <span class="eco-label">{formatLabels[f]}</span>
              ))}
            </p>
          )}
          <span class={`eco-provenance eco-${e.provenance}`}>
            {provenanceLabels[e.provenance]}
          </span>
        </header>
        <p class="eco-description" set:html={e.html} />
        <ul class="eco-links">
          <li>
            <a href={e.link}>
              {e.provenance === "commercial" ? "Product page" : "Project page"}
              <span class="sr-only"> for {e.name}</span>
            </a>
          </li>
          {e.docs && (
            <li>
              <a href={e.docs}>
                SPIFFE integration docs
                <span class="sr-only"> for {e.name}</span>
              </a>
            </li>
          )}
          {e.guides?.map((g) => (
            <li>
              <a href={g.link}>Guide: {g.title}</a>
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
