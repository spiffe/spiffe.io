---
import { inline } from "../lib/content";
import {
  entries,
  entryId,
  formatLabels,
  provenanceLabels,
  sorted,
} from "../lib/ecosystem";

interface Props {
  kind: string;
}

const list = await Promise.all(
  sorted(entries.filter((e) => e.kind === Astro.props.kind)).map(
    async (e) => ({ ...e, html: await inline(e.description) }),
  ),
);
---

<div class="eco-entries not-content">
  {
    list.map((e) => (
      <article class="eco-entry" id={entryId(e)}>
        <header>
          <h3>{e.name}</h3>
          {(e.kind !== "issuers" && e.issues) || e.accepts?.formats ? (
            <p class="eco-labels">
              {e.kind !== "issuers" && e.issues && (
                <span class="eco-label">Issues SVIDs</span>
              )}
              {e.accepts?.formats && (
                <>
                  <span>Accepts</span>
                  {e.accepts.formats.map((f) => (
                    <span class="eco-label">{formatLabels[f]}</span>
                  ))}
                </>
              )}
              {e.accepts?.support && (
                <>
                  <span aria-hidden="true">·</span>
                  <span class="eco-label">
                    {e.accepts.support === "native"
                      ? "SPIFFE-native"
                      : "SPIFFE-compatible"}
                  </span>
                </>
              )}
            </p>
          ) : null}
          <span class={`eco-provenance eco-${e.provenance}`}>
            {provenanceLabels[e.provenance]}
          </span>
        </header>
        <p class="eco-description" set:html={e.html} />
        <ul class="eco-links">
          <li>
            <a href={e.link}>
              {e.provenance === "commercial" ? "Product page" : "Project page"}
              <span class="sr-only"> for {e.name}</span>
            </a>
          </li>
          {e.docs && (
            <li>
              <a href={e.docs}>
                SPIFFE integration docs
                <span class="sr-only"> for {e.name}</span>
              </a>
            </li>
          )}
          {e.guides?.map((g) => (
            <li>
              <a href={g.link}>Guide: {g.title}</a>
            </li>
          ))}
        </ul>
      </article>
    ))
  }
</div>
