{
  "name": "spiffe-io-renewed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/releases.mjs && astro build && node scripts/redirects.mjs && node scripts/verify.mjs",
