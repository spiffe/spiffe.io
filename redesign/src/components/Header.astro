---
import Search from '@astrojs/starlight/components/Search.astro';
const path = Astro.url.pathname;
const links = [
  ['SPIFFE', '/docs/spiffe/overview/'], ['SPIRE', '/spire/'],
  ['Ecosystem', '/ecosystem/'], ['Community', '/community/'], ['Blog', '/blog/'],
];
const active = (href: string) => href === '/spire/' ? path.startsWith('/spire/') || path.startsWith('/docs/spire/') : path.startsWith(href === '/docs/spiffe/overview/' ? '/docs/spiffe/' : href);
---
<div class="site-header">
  <a href="/" class="brand" aria-label="SPIFFE home"><img src="/img/logos/spiffe/horizontal/color/spiffe-horizontal-color.svg" width="131" height="38" alt="SPIFFE" /></a>
  <nav class="primary-nav" aria-label="Main navigation">
    {links.map(([label, href]) => <a href={href} aria-current={active(href) ? 'true' : undefined}>{label}</a>)}
  </nav>
  <div class="header-search"><Search /></div>
  <a class="header-github" href="https://github.com/spiffe" aria-label="SPIFFE on GitHub"><svg viewBox="0 0 24 24" width="21" height="21" fill="currentColor" aria-hidden="true"><path d="M12 .8a11.2 11.2 0 0 0-3.54 21.83c.56.1.77-.24.77-.54v-2.1c-3.12.68-3.78-1.33-3.78-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.73 2.63 1.23 3.27.94.1-.73.4-1.23.71-1.51-2.49-.28-5.11-1.25-5.11-5.54 0-1.22.44-2.22 1.15-3.01-.12-.28-.5-1.42.11-2.96 0 0 .94-.3 3.08 1.15A10.75 10.75 0 0 1 12 6.17c.95 0 1.9.13 2.79.38 2.14-1.45 3.08-1.15 3.08-1.15.61 1.54.23 2.68.11 2.96.71.79 1.15 1.79 1.15 3.01 0 4.3-2.62 5.26-5.13 5.53.41.35.77 1.03.77 2.08v3.11c0 .3.2.65.78.54A11.2 11.2 0 0 0 12 .8Z" /></svg></a>
  <details class="site-menu"><summary aria-label="Site navigation">Explore <span aria-hidden="true">⌄</span></summary><nav aria-label="Mobile site navigation">{links.map(([label, href]) => <a href={href}>{label}</a>)}<a href="/downloads/">Download SPIRE</a></nav></details>
</div>
