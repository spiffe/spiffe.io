---
import posts from '../data/posts.json';
---
<div class="splash-panel not-content">
  {posts.map(post => <article class="blog-row"><time datetime={post.date}>{new Date(post.date).toLocaleDateString('en-US', {year:'numeric',month:'short',day:'numeric',timeZone:'UTC'})}</time><div><h2><a href={`/blog/${post.slug}/`}>{post.title}</a></h2><p>{post.description}</p><p class="author">{post.author}</p></div></article>)}
</div>
