---
import raw from '../../../data/users.yaml?raw';
import YAML from 'yaml';
const { adopters } = YAML.parse(raw);
// Compensate for whitespace and differing proportions in the upstream artwork.
const opticalScale: Record<string, number> = {
  Bloomberg: 1.8, 'Cisco Systems': 1.2, 'Duke Energy': 0.85,
  'Greymatter.io': 0.9, Hashicorp: 0.8, 'Hewlett-Packard Enterprise': 1.4,
  IBM: 1.3, Indeed: 0.8, Intel: 1.2, 'Palo Alto Networks': 0.95,
  Riptides: 0.9, SAP: 1.2, VMware: 1.9, Wise: 0.95,
};
---
<section class="adopters" aria-labelledby="adopters-heading">
  <h2 id="adopters-heading">SPIFFE and SPIRE adopters</h2>
  <ul role="list" aria-live="off">
    {adopters.map(({ name, logo }: { name: string; logo: string }) =>
      <li><span class="adopter-logo">
        <img src={`/img/logos/${logo}`} alt={name} width="140" height="56" loading="lazy" style={`--logo-scale: ${opticalScale[name] || 1.6}`} />
      </span></li>
    )}
  </ul>
</section>
<script>
  const section = document.querySelector<HTMLElement>('.adopters');
  if (section) {
    const list = section.querySelector('ul')!;
    const items = Array.from(list.children) as HTMLLIElement[];
    const logos = items.map(item => item.querySelector('span')!);
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const compact = matchMedia('(max-width: 900px)');
    let slots: HTMLLIElement[] = [];
    let waiting: HTMLSpanElement[] = [];
    let visible = false;
    const timers = new Set<ReturnType<typeof setTimeout>>();
    const later = (callback: () => void, delay: number) => {
      const timer = setTimeout(() => { timers.delete(timer); callback(); }, delay);
      timers.add(timer);
    };
    const stop = () => {
      timers.forEach(clearTimeout);
      timers.clear();
      slots.forEach(slot => slot.classList.remove('leaving', 'entering'));
    };
    const running = () => waiting.length > 0 && !reducedMotion.matches && visible && !document.hidden;
    const schedule = () => {
      stop();
      if (!running()) return;
      later(() => {
        slots.forEach((slot, index) => later(() => slot.classList.add('leaving'), index * 90));
        later(schedule, (slots.length - 1) * 90 + 500);
      }, 5500);
    };
    // Move the original logos between fixed slots. The queue contains only
    // organizations that are not currently displayed.
    list.addEventListener('animationend', event => {
      const slot = (event.target as Element).closest('li')!;
      if (event.animationName === 'adopter-out' && running()) {
        const next = waiting.shift()!;
        waiting.push(slot.firstElementChild as HTMLSpanElement);
        slot.replaceChildren(next);
        slot.classList.replace('leaving', 'entering');
      } else if (event.animationName === 'adopter-in') {
        slot.classList.remove('entering');
      }
    });
    const configure = () => {
      stop();
      items.forEach((item, index) => item.replaceChildren(logos[index]));
      const count = reducedMotion.matches ? items.length : Math.min(compact.matches ? 6 : 10, items.length);
      slots = items.slice(0, count);
      waiting = logos.slice(count);
      list.replaceChildren(...slots);
      schedule();
    };
    document.addEventListener('visibilitychange', schedule);
    reducedMotion.addEventListener('change', configure);
    compact.addEventListener('change', configure);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      schedule();
    }, { threshold: 0.1 }).observe(section);
    // Load the small SVGs before their first appearance, including queued logos.
    logos.forEach(logo => { logo.querySelector('img')!.loading = 'eager'; });
    configure();
  }
</script>
<style>
  @layer site {
    .adopters { padding: 1.5rem 0 2.5rem; }
    .adopters h2 { text-align: center; color: var(--muted); font-size: 1rem; font-weight: 500; letter-spacing: 0; margin: 0 0 2rem; }
    .adopters ul { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 1.6rem 2.5rem; list-style: none; padding: 0; margin: 0; }
    .adopters li { display: flex; align-items: center; justify-content: center; height: 72px; perspective: 600px; overflow: clip; overflow-clip-margin: 6px; }
    .adopter-logo { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; }
    .adopters img { width: 140px; max-width: 85%; height: 56px; object-fit: contain; transform: scale(var(--logo-scale)); }
    @media (prefers-reduced-motion: no-preference) {
      .leaving .adopter-logo { animation: adopter-out 250ms ease-in both; }
      .entering .adopter-logo { animation: adopter-in 250ms ease-out both; }
    }
    @keyframes adopter-out { to { transform: translateY(-6px) rotateX(40deg); opacity: 0; } }
    @keyframes adopter-in { from { transform: translateY(6px) rotateX(-40deg); opacity: 0; } to { transform: none; opacity: 1; } }
    @media (max-width: 900px) { .adopters ul { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem 2rem; } }
    @media (max-width: 650px) { .adopters { padding: 1rem 0 2rem; } .adopters h2 { font-size: .95rem; } .adopters ul { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem 1.5rem; } }
  }
</style>
