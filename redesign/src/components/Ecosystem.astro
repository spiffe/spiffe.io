---
import rawData from '../data/ecosystem.yaml?raw';
import commercial from '../data/commercial-offerings.json';
import YAML from 'yaml';
const { commercialOnly = false } = Astro.props;
const data = YAML.parse(rawData);
const categories = [...data.categories, {
  name: 'Commercial products and services',
  weight: 150,
  description: 'Identity issuers, SPIRE integrations, and services that accept workload identities. Descriptions are based on the linked vendor documentation, checked 22 October 2026.',
  projects: commercial.map(project => ({ ...project, type: 'commercial', weight: 100 })),
}].map(category => ({ ...category, projects: category.projects.map((project: any) => ({ ...project, identityRoles: project.identityRoles || ['Integration'] })) }))
  .map(category => ({ ...category, projects: commercialOnly ? category.projects.filter((project: any) => project.type === 'commercial') : category.projects }))
  .filter(category => category.projects.length)
  .sort((a: any, b: any) => a.weight - b.weight);
const total = categories.reduce((sum: number, c: any) => sum + c.projects.length, 0);
const types: Record<string,string> = { official: 'SPIFFE project', community: 'Community project', commercial: 'Commercial' };
---
<div class="splash-panel not-content">
  <p class="page-intro">{commercialOnly ? 'Commercial products that issue SPIFFE identities, operate SPIRE, or accept SVIDs for authentication. Each offering has a different scope.' : 'Find implementations and the tools that work with them. Entries describe what each project provides.'} The <a href="/ecosystem/matrix/">implementation matrix</a> records community declarations for specific interfaces.</p>
  <p class="source-note">Identity issuers provide SVIDs. Integrations help operate identity systems or use SVIDs in applications. Services that accept identities authenticate workloads with SVIDs or exchange them for service credentials.</p>
  <nav class="directory-views" aria-label="Ecosystem view"><a href="/ecosystem/" aria-current={!commercialOnly ? 'page' : undefined}>All projects</a><a href="/ecosystem/commercial/" aria-current={commercialOnly ? 'page' : undefined}>Commercial offerings</a></nav>
  <div class="directory-toolbar"><label>Find a project<input id="project-query" type="search" placeholder="Name, platform, or capability" /></label>{!commercialOnly && <label>Maintained by<select id="project-type"><option value="all">All projects</option><option value="official">SPIFFE project</option><option value="community">Community project</option><option value="commercial">Commercial</option></select></label>}<p id="project-count" class="directory-count" aria-live="polite">{total} entries</p></div>
  <p class="empty-results" id="project-empty" hidden>No matching projects. Try another term or select all projects.</p>
  {categories.map((category: any) => <section class="directory-category"><h2>{category.name}</h2><p>{category.description}</p>{category.projects.sort((a: any,b: any) => a.weight - b.weight || a.name.localeCompare(b.name)).map((project: any) => <article class="directory-entry" data-project-type={project.type} data-search={`${project.name} ${project.identityRoles.join(' ')} ${project.description} ${project.scope || ''} ${(project.capabilities || []).join(' ')} ${category.name}`.toLowerCase()}><div class="entry-name"><h3><a href={project.link}>{project.name} <span aria-hidden="true">↗</span></a></h3><p class="entry-role">{project.identityRoles.join(' · ')}</p>{project.role && <p class="entry-role">{project.role}</p>}</div><div class="entry-copy"><p>{project.description}</p>{project.capabilities && <ul class="capability-list" aria-label="Documented capabilities">{project.capabilities.map((capability: string) => <li>{capability}</li>)}</ul>}{project.scope && <p class="entry-scope">{project.scope}</p>}{project.sources && <div class="entry-sources">{project.sources.map((source: any) => <a href={source.url}>{source.label} ↗</a>)}</div>}{project.guide && <p><a href={project.guide.url}>{project.guide.label} →</a></p>}</div><span class="type-label">{types[project.type]}</span></article>)}</section>)}
  <p class="source-note">Listings link to documented capabilities. Consult the implementation matrix for declared interface support.</p>
  <p class="source-note">Suggest additions or corrections through a pull request to the <a href="https://github.com/spiffe/spiffe.io">SPIFFE website</a>.</p>
</div>
<script>
  const query = document.querySelector<HTMLInputElement>('#project-query');
  const type = document.querySelector<HTMLSelectElement>('#project-type');
  function filter() {
    let shown = 0;
    document.querySelectorAll<HTMLElement>('.directory-entry').forEach((entry) => {
      const match = (entry.dataset.search || '').includes((query?.value || '').toLowerCase().trim()) && (!type || type.value === 'all' || type.value === entry.dataset.projectType);
      entry.hidden = !match; if (match) shown++;
    });
    document.querySelectorAll<HTMLElement>('.directory-category').forEach((category) => { category.hidden = !category.querySelector('.directory-entry:not([hidden])'); });
    const count = document.querySelector('#project-count'); if (count) count.textContent = `${shown} ${shown === 1 ? 'entry' : 'entries'}`;
    const empty = document.querySelector<HTMLElement>('#project-empty'); if (empty) empty.hidden = shown > 0;
  }
  query?.addEventListener('input', filter); type?.addEventListener('change', filter);
</script>
