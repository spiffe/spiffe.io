---
import Default from "@astrojs/starlight/components/PageTitle.astro";
const { entry } = Astro.locals.starlightRoute;
const {
  date,
  author,
  tags,
  draft,
  description,
  hideTitle,
  hideDescription,
  readingTime,
} = entry.data;
---

{!hideTitle ? (
  <Default>
    <slot />
  </Default>
) : (
  <span id="_top"></span>
)}
{description && !hideDescription && !date && (
  <p class="page-description">{description}</p>
)}
{entry.id.startsWith("blog/") && date && (
  <p class="post-meta">
    {author && `By ${author} ·`}{" "}
    <time datetime={date.toISOString()}>
      {date.toLocaleDateString("en-US", {
        year: "numeric",
        month: "long",
        day: "numeric",
        timeZone: "UTC",
      })}
    </time>
    {readingTime && <span> · {readingTime} min read</span>}
    {draft && <strong> · Draft</strong>}
  </p>
)}
<style>
  .post-meta {
    color: var(--sl-color-gray-2);
    font-size: 0.85rem;
  }
</style>
